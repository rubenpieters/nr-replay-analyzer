    "test:update": "node scripts/updateGolden.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
