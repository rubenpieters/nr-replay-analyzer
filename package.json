{
  "name": "nr-replay-analyzer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && npx esbuild src/web.ts --bundle --outfile=dist/web.js --format=iife --platform=browser",
    "cli": "tsx src/main.ts",
    "regenerate": "tsx src/regenerate.ts",
    "fetch-cards": "tsx src/fetchCards.ts",
    "test": "vitest run",
    "test:update": "npx tsx scripts/updateGolden.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
